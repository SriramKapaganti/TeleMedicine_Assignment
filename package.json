{
  "name": "amrutam-telemedicine-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for Amrutam Telemedicine System focusing on scalability, reliability, security, and observability",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/jobs/worker.js",
    "dev": "nodemon src/server.js",
    "dev:worker": "nodemon src/jobs/worker.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:concurrency": "jest tests/concurrency --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint src/ tests/ scripts/ || exit 0"
  },
  "keywords": [
    "telemedicine",
    "healthcare",
    "nodejs",
    "express",
    "postgresql",
    "redis",
    "bullmq",
    "idempotency",
    "concurrency"
  ],
  "author": "Amrutam Engineering",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
