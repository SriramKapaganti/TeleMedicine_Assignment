# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=amrutam-telemedicine-backend
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amrutam_db
DB_USER=amrutam_user
DB_PASSWORD=amrutam_secure_password_2026
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_SSL=false

# Redis (Choose Option A or Option B)
# Option A: Single Connection URL (Cloud Redis, e.g. Upstash, Render, Railway, Redis Cloud)
# REDIS_URL=rediss://default:password@your-cloud-redis.com:6379
# Option B: Individual host/port parameters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# JWT Authentication
JWT_ACCESS_SECRET=amrutam_super_secret_jwt_access_key_min_32_chars_2026!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=amrutam_super_secret_jwt_refresh_key_min_32_chars_2026!
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM for PHI)
# 32-byte hex key (64 hex characters)
ENCRYPTION_KEY_CURRENT_VERSION=v1
ENCRYPTION_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MFA TOTP
MFA_SERVICE_NAME=AmrutamTelemedicine

# Payment Webhook Secret
PAYMENT_WEBHOOK_SECRET=whsec_amrutam_payment_webhook_secret_key_2026

# Logging & Monitoring
LOG_LEVEL=info
PROMETHEUS_METRICS_PATH=/metrics
